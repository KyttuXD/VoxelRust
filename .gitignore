/target
/dist
# Mods are kept out of the repository, except the ones that come with
# the game.
/mods/*
!/mods/disasters/
!/mods/earth/
!/mods/landvehicles/
!/mods/boats/
!/mods/trains/
!/mods/planes/
!/mods/holidays/
!/mods/vehicles/
!/mods/SHIPPED
!/mods/tests.rs
# Libraries shipped beside the game are fetched, not kept (see vendor/README.md).
/vendor/*
!/vendor/README.md
.claude/

